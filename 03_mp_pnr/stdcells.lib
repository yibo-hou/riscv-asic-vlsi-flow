library(stdcells) {

  delay_model : table_lookup;

  time_unit : "1ns";
  voltage_unit : "1V";
  current_unit : "1uA";
  pulling_resistance_unit : "1kohm";
  leakage_power_unit : "1nW";
  capacitive_load_unit (1,pf);

  cell (inv) {
    area : 0.59;
    pin(A)  { direction : input; }
    pin(y)  {
      direction : output;
      function : "(!A)";
      timing() {
        related_pin : "A";
        cell_rise(scalar) { values("0.0"); }
        rise_transition(scalar) { values("0.0"); }
        cell_fall(scalar) { values("0.0"); }
        fall_transition(scalar) { values("0.0"); }
      }
    }
  }

  cell (nor2) {
    area : 0.9;
    pin(A)  { direction : input; }
    pin(B)  { direction : input; }
    pin(y)  {
      direction : output;
      function : "(!(A+B))";
      timing() {
        related_pin : "A B";
        cell_rise(scalar) { values("0.0"); }
        rise_transition(scalar) { values("0.0"); }
        cell_fall(scalar) { values("0.0"); }
        fall_transition(scalar) { values("0.0"); }
      }
    }
  }

  cell (nand2) {
    area : 0.9;
    pin(A)  { direction : input; }
    pin(B)  { direction : input; }
    pin(y)  {
      direction : output;
      function : "(!(A B))";
      timing() {
        related_pin : "A B";
        cell_rise(scalar) { values("0.0"); }
        rise_transition(scalar) { values("0.0"); }
        cell_fall(scalar) { values("0.0"); }
        fall_transition(scalar) { values("0.0"); }
      }
    }
  }

  cell (and2) {
    area : 1.23;
    pin(A)  { direction : input; }
    pin(B)  { direction : input; }
    pin(y)  {
      direction : output;
      function : "(A B)";
      timing() {
        related_pin : "A B";
        cell_rise(scalar) { values("0.0"); }
        rise_transition(scalar) { values("0.0"); }
        cell_fall(scalar) { values("0.0"); }
        fall_transition(scalar) { values("0.0"); }
      }
    }
  }

  cell (or2) {
    area : 1.23;
    pin(A)  { direction : input; }
    pin(B)  { direction : input; }
    pin(y)  {
      direction : output;
      function : "(A+B)";
      timing() {
        related_pin : "A B";
        cell_rise(scalar) { values("0.0"); }
        rise_transition(scalar) { values("0.0"); }
        cell_fall(scalar) { values("0.0"); }
        fall_transition(scalar) { values("0.0"); }
      }
    }
  }

  cell (xor2) {
    area : 1.81;
    pin(A)  { direction : input; }
    pin(B)  { direction : input; }
    pin(y)  {
      direction : output;
      function : "(A^B)";
      timing() {
        related_pin : "A B";
        cell_rise(scalar) { values("0.0"); }
        rise_transition(scalar) { values("0.0"); }
        cell_fall(scalar) { values("0.0"); }
        fall_transition(scalar) { values("0.0"); }
      }
    }
  }

  cell (xnor2) {
    area : 1.82;
    pin(A)  { direction : input; }
    pin(B)  { direction : input; }
    pin(y)  {
      direction : output;
      function : "(!(A^B))";
      timing() {
        related_pin : "A B";
        cell_rise(scalar) { values("0.0"); }
        rise_transition(scalar) { values("0.0"); }
        cell_fall(scalar) { values("0.0"); }
        fall_transition(scalar) { values("0.0"); }
      }
    }
  }

  cell (buf) {
    area : 0.98;
    pin(A)  { direction : input; }
    pin(y)  {
      direction : output;
      function : "A";
      timing() {
        related_pin : "A";
        cell_rise(scalar) { values("0.0"); }
        rise_transition(scalar) { values("0.0"); }
        cell_fall(scalar) { values("0.0"); }
        fall_transition(scalar) { values("0.0"); }
      }
    }
  }

  cell (mux2) {
    area : 2.31;
    pin(A)  { direction : input; }
    pin(B)  { direction : input; }
    pin(S0)  { direction : input; }
    pin(y)  {
      direction : output;
      function : "((S0 B) + (!S0 A))"; 
      timing() {
        related_pin : "A B S0";
        cell_rise(scalar) { values("0.0"); }
        rise_transition(scalar) { values("0.0"); }
        cell_fall(scalar) { values("0.0"); }
        fall_transition(scalar) { values("0.0"); }
      }
    }
  }

  cell (aoi21) {
    area : 1.2;
    pin(A)  { direction : input; }
    pin(B)  { direction : input; }
    pin(C)  { direction : input; }
    pin(y)  {
      direction : output;
      function : "(!((A B) + C))";
      timing() {
        related_pin : "A B C";
        cell_rise(scalar) { values("0.0"); }
        rise_transition(scalar) { values("0.0"); }
        cell_fall(scalar) { values("0.0"); }
        fall_transition(scalar) { values("0.0"); }
      }
    }
  }

  cell (oai21) {
    area : 1.2;
    pin(A)  { direction : input; }
    pin(B)  { direction : input; }
    pin(C)  { direction : input; }
    pin(y)  {
      direction : output;
      function : "(!((A+B) C))";
      timing() {
        related_pin : "A B C";
        cell_rise(scalar) { values("0.0"); }
        rise_transition(scalar) { values("0.0"); }
        cell_fall(scalar) { values("0.0"); }
        fall_transition(scalar) { values("0.0"); }
      }
    }
  }

  cell (dff) {
    area : 5.3;
    ff (I_Q,I_QN) {
      next_state : "D";
      clocked_on : "CLK";
    }
    pin(CLK)  {
      direction : input;
      clock : true;
    }
    pin(D)  { direction : input; }
    pin(Q)  {
      direction : output;
      function : "I_Q";
      timing() {
        related_pin : "CLK";
        timing_type : rising_edge;
        cell_rise(scalar) { values("0.0"); }
        rise_transition(scalar) { values("0.0"); }
        cell_fall(scalar) { values("0.0"); }
        fall_transition(scalar) { values("0.0"); }
      }
    }
  }

  cell (latch) {
    area : 3.11;
    latch (I_Q,I_QN) {
      enable : "EN";
      data_in : "D";
    }
    pin(EN)  { direction : input; }
    pin(D)  { direction : input; }
    pin(Q)  {
      direction : output;
      function : "I_Q";
      timing() {
        related_pin : "EN";
        timing_type : rising_edge;
        cell_rise(scalar) { values("0.0"); }
        rise_transition(scalar) { values("0.0"); }
        cell_fall(scalar) { values("0.0"); }
        fall_transition(scalar) { values("0.0"); }
      }
    }
  }

}
